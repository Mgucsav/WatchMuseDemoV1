# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Gerçek değer içermeyen örnek dosya depoda tutulur.
!.env.example

# secrets / credentials — asla commit edilmez
# (.env* kuralı yukarıda; buradakiler ek güvenlik ağıdır)
*service_role*
*.key
*.p12
*.pfx
secrets.json

# curl / tarayıcı cookie jar'ları — oturum çerezi taşıyabilir
cookie*.txt
cookiejar*.txt
*.cookies

# geçici tünel araçları ve çıktıları (cloudflared, ngrok vb.)
cloudflared*
*cloudflared*.log
ngrok*
*ngrok*.log
tunnel*.log
*.pid

# log ve geçici dosyalar
*.log
!package-lock.json
*.tmp
nohup.out

# işletim sistemi
Thumbs.db
Desktop.ini

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
