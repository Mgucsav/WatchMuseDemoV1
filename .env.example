# =============================================================================
# WatchMuse — ortam değişkenleri ÖRNEĞİ
#
# Bu dosya depoda saklanır ve GERÇEK DEĞER İÇERMEZ.
# Gerçek değerlerinizi `.env.local` dosyasına yazın; o dosya `.gitignore`
# tarafından depo dışında tutulur ve ASLA commit edilmemelidir.
#
# Kullanım:
#   Copy-Item .env.example .env.local    (PowerShell)
#   cp .env.example .env.local           (macOS / Linux)
# =============================================================================

# -----------------------------------------------------------------------------
# TMDb — GİZLİ
# -----------------------------------------------------------------------------
# https://www.themoviedb.org/settings/api adresindeki "API Read Access Token".
# Kısa "API Key (v3 auth)" DEĞİL; doğru değer `eyJ` ile başlar ve iki nokta içerir.
#
# Yalnızca sunucu tarafında okunur. Adının başında NEXT_PUBLIC_ YOKTUR ve
# olmamalıdır; aksi halde token tarayıcıya gönderilir.
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# For a keyless, temporary preview, use this explicit demo mode instead.
# It returns deterministic sample movie/provider data and makes no TMDb request.
# TMDB_ACCESS_TOKEN=DEMO

# -----------------------------------------------------------------------------
# Supabase — GİZLİ DEĞİL
# -----------------------------------------------------------------------------
# Bu iki değer bilinçli olarak herkese açıktır ve tarayıcıda kullanılır.
# Anon/publishable anahtar tek başına hiçbir yetki vermez; erişimi Row Level
# Security politikaları belirler. Bu yüzden NEXT_PUBLIC_ öneki burada doğrudur.
#
# Supabase Dashboard → Project Settings → API bölümünden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# If Supabase is not configured, local rooms are selected automatically. To
# explicitly keep local rooms while Supabase values are present, set both:
# USE_LOCAL_ROOMS=true
# NEXT_PUBLIC_USE_LOCAL_ROOMS=true

# UYARI: SUPABASE_SERVICE_ROLE_KEY bu projede KULLANILMAZ ve buraya ya da
# `.env.local` dosyasına EKLENMEMELİDİR. Row Level Security'yi tamamen atlar;
# sızması tüm kullanıcı verisinin okunabilir hale gelmesi demektir.
#
# Hesap ve kütüphane kurulumu: AUTH_AND_LIBRARY_SETUP.md

# -----------------------------------------------------------------------------
# Site adresi — opsiyonel
# -----------------------------------------------------------------------------
# Davet bağlantıları normalde gelen isteğin adresinden türetilir. Ters vekil
# veya özel alan adı arkasında çalışıyorsanız burayı ayarlayın.
# Yerel gelistirme icin:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canli ortamda kendi adresinizi yazin:
# NEXT_PUBLIC_SITE_URL=https://watchmuse.example.com
